FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    STREAMLIT_API_BASE_URL=http://api:8000

COPY requirements-frontend.txt pyproject.toml README.md .env.example ./

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements-frontend.txt

COPY frontend/ ./frontend/
COPY runtime_assets/artifacts/frontend/ ./artifacts/frontend/

EXPOSE 8501

CMD ["streamlit", "run", "frontend/streamlit_app.py", "--server.address=0.0.0.0", "--server.port=8501"]
