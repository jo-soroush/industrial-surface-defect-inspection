APP_ENV=development
DATA_PATH=./data
MODEL_PATH=./artifacts/models
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Default safe Docker/Compose runtime remains mock-first and disabled for real providers.
AGENT_ENABLE_LLM=false
AGENT_ENABLE_REAL_PROVIDER_RUNTIME=false
AGENT_DEFAULT_PROVIDER=mock
LLM_PROVIDER_ORDER=mock,gemini,grok
LLM_ENABLE_FALLBACK=true
LLM_MAX_RETRIES=1
GEMINI_API_KEY=

# To enable Gemini for local Docker/EC2 smoke validation, override these at runtime only:
# AGENT_ENABLE_LLM=true
# AGENT_ENABLE_REAL_PROVIDER_RUNTIME=true
# AGENT_DEFAULT_PROVIDER=gemini
# LLM_PROVIDER_ORDER=gemini,mock
# GEMINI_API_KEY=<runtime secret only>
